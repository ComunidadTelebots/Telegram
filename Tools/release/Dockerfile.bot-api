FROM debian:bookworm AS build
ARG BOT_API_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates cmake g++ make gperf libssl-dev zlib1g-dev
RUN test "${#BOT_API_COMMIT}" -eq 40 && git clone https://github.com/tdlib/telegram-bot-api.git /src && cd /src && git checkout "$BOT_API_COMMIT" && git submodule update --init --recursive
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release && cmake --build /build -j1 --target telegram-bot-api
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 zlib1g libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/telegram-bot-api /usr/local/bin/
COPY bot-api.sh /usr/local/bin/start-bot-api
ENTRYPOINT ["sh", "/usr/local/bin/start-bot-api"]
